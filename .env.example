# Copy this to .env for local development
# On Render, set these as Environment Variables in the dashboard

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/cot_tracker

# JWT secret — make this long and random
JWT_SECRET=replace-with-a-long-random-string

# App password — what users type to log in
APP_PASSWORD=your-secure-password-here

# Set to 'production' on Render
NODE_ENV=production

# Your Render app URL (for CORS)
ALLOWED_ORIGIN=https://cot-tracker.onrender.com

# Port (Render sets this automatically)
PORT=3000